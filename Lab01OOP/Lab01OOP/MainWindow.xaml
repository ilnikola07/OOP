<Window x:Class="Lab01OOP.MainWindow"
        xmlns:local="clr-namespace:Lab01OOP"
        xmlns:loc="clr-namespace:CodingSeb.Localization.WPF;assembly=CodingSeb.Localization.WPF"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"      
        xmlns:vm="clr-namespace:Lab01OOP.ViewModels"
        mc:Ignorable="d"
        FontFamily="{Binding SelectedFont}"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}" Title="{Tr 'App.Title'}" Height="750" Width="1100">

    <!-- Подключение ViewModel -->
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <TabControl>

            <!-- ВКЛАДКА 1: Основное -->
            <TabItem Header="{Tr 'Tab.Main'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="Настройки персонализации">
                            <StackPanel>
                                <TextBlock Text="Тема приложения:" Style="{StaticResource BodyTextStyle}"/>
                                <ComboBox Width="250" HorizontalAlignment="Left" Margin="0,0,0,10"
                                          ItemsSource="{Binding Themes}"
                                          SelectedItem="{Binding SelectedTheme}"/>

                                <TextBlock Text="Язык приложения:" Style="{StaticResource BodyTextStyle}"/>
                                <ComboBox Width="250" HorizontalAlignment="Left"
                                          ItemsSource="{Binding Languages}"
                                          SelectedItem="{Binding SelectedLanguage}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Настройки шрифтов">
                            <StackPanel>
                                <TextBlock Text="Шрифт:" Style="{StaticResource BodyTextStyle}"/>
                                <ComboBox Width="250" HorizontalAlignment="Left" Margin="0,0,0,15"
                                          ItemsSource="{Binding Fonts}"
                                          SelectedItem="{Binding SelectedFont}"/>

                                <TextBlock Text="Размер шрифта:" Style="{StaticResource BodyTextStyle}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Slider Width="250" Minimum="8" Maximum="32"
                                            Value="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            VerticalAlignment="Center" Margin="0,0,15,0"/>
                                    <TextBlock Text="{Binding FontSize, StringFormat={}{0:F0} pt}"
                                               VerticalAlignment="Center" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ВКЛАДКА 2: Цветовая палитра -->
            <TabItem Header="{Tr 'Tab.Palette'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <!-- Использование стиля заголовка и привязка к теме -->
                        <TextBlock Text="{Binding SelectedTheme, StringFormat=Текущая тема: {0}}"
                                   Style="{StaticResource Heading2Style}" Margin="0,0,0,20"/>

                        <GroupBox Header="Основные и индикаторные цвета">
                            <WrapPanel>
                                <Border Width="120" Height="80" Background="{StaticResource BackgroundBrush}" 
                                        Margin="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <TextBlock Text="Основной" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Width="120" Height="80" Background="{StaticResource PrimaryBrush}" Margin="5">
                                    <TextBlock Text="Акцентный" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                </Border>
                                <Border Width="120" Height="80" Background="{StaticResource SuccessBrush}" Margin="5">
                                    <TextBlock Text="Успех" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                </Border>
                                <Border Width="120" Height="80" Background="{StaticResource ErrorBrush}" Margin="5">
                                    <TextBlock Text="Ошибка" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                </Border>
                                <Border Width="120" Height="80" Background="{StaticResource InfoBrush}" Margin="5">
                                    <TextBlock Text="Информация" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                </Border>
                            </WrapPanel>
                        </GroupBox>

                        <TextBlock Text="Палитра оттенков (10 оттенков для каждого цвета)" 
                                   Style="{StaticResource Heading3Style}" Margin="0,10,0,10"/>

                        <!-- Таблицы с оттенками используют автоматический стиль DataGrid из ресурсов -->
                        <GroupBox Header="Основной (#F3F3F3)">
                            <DataGrid ItemsSource="{Binding ShadesMain}" AutoGenerateColumns="False"
                                      HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True" MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Цвет" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding ColorBrush}" Height="20" Margin="2" BorderBrush="LightGray" BorderThickness="1"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="RGB код" Binding="{Binding RgbCode}" Width="*"/>
                                    <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GroupBox Header="Акцентный (#0078D7)">
                            <DataGrid ItemsSource="{Binding ShadesAccent}" AutoGenerateColumns="False"
                                      HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True" MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Цвет" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding ColorBrush}" Height="20" Margin="2" BorderBrush="LightGray" BorderThickness="1"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="RGB код" Binding="{Binding RgbCode}" Width="*"/>
                                    <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GroupBox Header="Успех (#107C10)">
                            <DataGrid ItemsSource="{Binding ShadesSuccess}" AutoGenerateColumns="False"
                                      HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True" MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Цвет" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding ColorBrush}" Height="20" Margin="2" BorderBrush="LightGray" BorderThickness="1"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="RGB код" Binding="{Binding RgbCode}" Width="*"/>
                                    <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GroupBox Header="Ошибка (#D13438)">
                            <DataGrid ItemsSource="{Binding ShadesError}" AutoGenerateColumns="False"
                                      HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True" MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Цвет" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding ColorBrush}" Height="20" Margin="2" BorderBrush="LightGray" BorderThickness="1"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="RGB код" Binding="{Binding RgbCode}" Width="*"/>
                                    <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GroupBox Header="Информация (#FF8C00)">
                            <DataGrid ItemsSource="{Binding ShadesInfo}" AutoGenerateColumns="False"
                                      HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True" MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Цвет" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding ColorBrush}" Height="20" Margin="2" BorderBrush="LightGray" BorderThickness="1"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="RGB код" Binding="{Binding RgbCode}" Width="*"/>
                                    <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ВКЛАДКА 3: Элементы управления -->
            <TabItem Header="{Tr 'Tab.Controls'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <Expander Header="Кнопки (Акцент / Критический × состояния)" IsExpanded="True" Margin="0,0,0,10">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Margin="5">
                                    <StackPanel Margin="5">
                                        <TextBlock Text="Акцент" FontWeight="Bold" Background="{StaticResource PrimaryBrush}" 
                                                   Foreground="White" Padding="5" HorizontalAlignment="Center"/>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>

                                            <!-- Кнопки используют стиль PrimaryButtonStyle -->
                                            <Button Grid.Row="0" Grid.Column="0" Content="Обычная" Style="{StaticResource PrimaryButtonStyle}"/>
                                            <Button Grid.Row="0" Grid.Column="1" Content="Нажата" Background="#005A9E" Foreground="White" Padding="12,6" Margin="5" Cursor="Hand"/>
                                            <Button Grid.Row="0" Grid.Column="2" Content="Загрузка" Background="#4FADFF" Foreground="Black" Padding="12,6" Margin="5" Cursor="Hand"/>
                                            <Button Grid.Row="0" Grid.Column="3" Content="Неактивна" IsEnabled="False" Padding="12,6" Margin="5"/>

                                            <Button Grid.Row="1" Grid.Column="0" Content="Обычная" Background="White" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" Padding="12,6" Margin="5" Cursor="Hand"/>
                                            <Button Grid.Row="1" Grid.Column="1" Content="Нажата" Background="#E6F2FF" BorderBrush="#005A9E" BorderThickness="1" Padding="12,6" Margin="5" Cursor="Hand"/>
                                            <Button Grid.Row="1" Grid.Column="2" Content="Загрузка" Background="#E6F2FF" BorderBrush="#4FADFF" BorderThickness="1" Padding="12,6" Margin="5" Cursor="Hand"/>
                                            <Button Grid.Row="1" Grid.Column="3" Content="Неактивна" IsEnabled="False" Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1" Padding="12,6" Margin="5"/>

                                            <Button Grid.Row="2" Grid.Column="0" Content="Обычная" Background="Transparent" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" Padding="12,6" Margin="5" Cursor="Hand"/>
                                            <Button Grid.Row="2" Grid.Column="1" Content="Нажата" Background="Transparent" BorderBrush="#005A9E" BorderThickness="1" Padding="12,6" Margin="5" Cursor="Hand"/>
                                            <Button Grid.Row="2" Grid.Column="2" Content="Загрузка" Background="Transparent" BorderBrush="#4FADFF" BorderThickness="1" Padding="12,6" Margin="5" Cursor="Hand"/>
                                            <Button Grid.Row="2" Grid.Column="3" Content="Неактивна" IsEnabled="False" Background="Transparent" BorderBrush="#CCCCCC" BorderThickness="1" Padding="12,6" Margin="5"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Margin="5">
                                        <TextBlock Text="Критический" FontWeight="Bold" Background="{StaticResource ErrorBrush}" 
                                                   Foreground="White" Padding="5" HorizontalAlignment="Center"/>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>

                                            <Button Grid.Row="0" Grid.Column="0" Content="Обычная" Background="{StaticResource ErrorBrush}" Foreground="White" Padding="12,6" Margin="5" Cursor="Hand"/>
                                            <Button Grid.Row="0" Grid.Column="1" Content="Нажата" Background="#9A272B" Foreground="White" Padding="12,6" Margin="5" Cursor="Hand"/>
                                            <Button Grid.Row="0" Grid.Column="2" Content="Загрузка" Background="#FF8A8A" Foreground="Black" Padding="12,6" Margin="5" Cursor="Hand"/>
                                            <Button Grid.Row="0" Grid.Column="3" Content="Неактивна" IsEnabled="False" Padding="12,6" Margin="5"/>

                                            <Button Grid.Row="1" Grid.Column="0" Content="Обычная" Background="White" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1" Padding="12,6" Margin="5" Cursor="Hand"/>
                                            <Button Grid.Row="1" Grid.Column="1" Content="Нажата" Background="#FFEBEE" BorderBrush="#9A272B" BorderThickness="1" Padding="12,6" Margin="5" Cursor="Hand"/>
                                            <Button Grid.Row="1" Grid.Column="2" Content="Загрузка" Background="#FFEBEE" BorderBrush="#FF8A8A" BorderThickness="1" Padding="12,6" Margin="5" Cursor="Hand"/>
                                            <Button Grid.Row="1" Grid.Column="3" Content="Неактивна" IsEnabled="False" Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1" Padding="12,6" Margin="5"/>

                                            <Button Grid.Row="2" Grid.Column="0" Content="Обычная" Background="Transparent" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1" Padding="12,6" Margin="5" Cursor="Hand"/>
                                            <Button Grid.Row="2" Grid.Column="1" Content="Нажата" Background="Transparent" BorderBrush="#9A272B" BorderThickness="1" Padding="12,6" Margin="5" Cursor="Hand"/>
                                            <Button Grid.Row="2" Grid.Column="2" Content="Загрузка" Background="Transparent" BorderBrush="#FF8A8A" BorderThickness="1" Padding="12,6" Margin="5" Cursor="Hand"/>
                                            <Button Grid.Row="2" Grid.Column="3" Content="Неактивна" IsEnabled="False" Background="Transparent" BorderBrush="#CCCCCC" BorderThickness="1" Padding="12,6" Margin="5"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Margin="15,0,0,0">
                                        <TextBlock Text="Переключатели" Style="{StaticResource Heading3Style}"/>
                                        <WrapPanel>
                                            <ToggleButton Content="Акцент" Padding="10,5" Margin="5" Background="{StaticResource PrimaryBrush}" Foreground="White"/>
                                            <ToggleButton Content="Критический" Padding="10,5" Margin="5" Background="{StaticResource ErrorBrush}" Foreground="White"/>
                                            <ToggleButton Content="Неактивен" Padding="10,5" Margin="5" IsEnabled="False"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Expander>

                        <Expander Header="Поля ввода и списки" IsExpanded="True" Margin="0,0,0,10">
                            <WrapPanel Margin="5">
                                <StackPanel Margin="5">
                                    <Label Content="TextBox"/>
                                    <TextBox Width="180" Text="Введите текст..."/>
                                </StackPanel>
                                <StackPanel Margin="5">
                                    <Label Content="PasswordBox"/>
                                    <PasswordBox Width="180"/>
                                </StackPanel>
                                <StackPanel Margin="5">
                                    <Label Content="ComboBox"/>
                                    <ComboBox Width="180" SelectedIndex="0">
                                        <ComboBoxItem Content="Элемент 1"/>
                                        <ComboBoxItem Content="Элемент 2"/>
                                        <ComboBoxItem Content="Элемент 3"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="5">
                                    <Label Content="ListBox"/>
                                    <ListBox Width="180" Height="80">
                                        <ListBoxItem Content="Элемент 1"/>
                                        <ListBoxItem Content="Элемент 2"/>
                                        <ListBoxItem Content="Элемент 3"/>
                                    </ListBox>
                                </StackPanel>
                                <StackPanel Margin="5">
                                    <Label Content="RichTextBox"/>
                                    <RichTextBox Width="280" Height="80">
                                        <FlowDocument>
                                            <Paragraph>
                                                Это
                                                <Bold>жирный</Bold> и
                                                <Italic>курсивный</Italic> текст.
                                            </Paragraph>
                                        </FlowDocument>
                                    </RichTextBox>
                                </StackPanel>
                            </WrapPanel>
                        </Expander>

                        <Expander Header="Текст и метки" IsExpanded="True" Margin="0,0,0,10">
                            <StackPanel Margin="5">
                                <TextBlock Text="Заголовок 1 (H1)" Style="{StaticResource Heading1Style}"/>
                                <TextBlock Text="Заголовок 2 (H2)" Style="{StaticResource Heading2Style}"/>
                                <TextBlock Text="Заголовок 3 (H3)" Style="{StaticResource Heading3Style}"/>
                                <TextBlock Text="Обычный текст (Body)" Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="Подпись (Caption)" Style="{StaticResource CaptionStyle}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="TreeView" IsExpanded="True" Margin="0,0,0,10">
                            <TreeView Width="250" Height="150" HorizontalAlignment="Left">
                                <TreeViewItem Header="Корневой узел 1">
                                    <TreeViewItem Header="Подузел 1.1"/>
                                    <TreeViewItem Header="Подузел 1.2">
                                        <TreeViewItem Header="Вложенный 1.2.1"/>
                                    </TreeViewItem>
                                </TreeViewItem>
                                <TreeViewItem Header="Корневой узел 2">
                                    <TreeViewItem Header="Подузел 2.1"/>
                                </TreeViewItem>
                            </TreeView>
                        </Expander>

                        <Expander Header="DataGrid (привязан к ViewModel)" IsExpanded="True" Margin="0,0,0,10">
                            <DataGrid ItemsSource="{Binding SampleItems}" AutoGenerateColumns="False"
                                      CanUserAddRows="False" IsReadOnly="True" Height="180" Margin="5">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                    <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                                    <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>

                        <Expander Header="ProgressBar" IsExpanded="True" Margin="0,0,0,10">
                            <StackPanel Margin="5">
                                <TextBlock Text="Определённый (65%)" Style="{StaticResource BodyTextStyle}"/>
                                <ProgressBar Width="300" Height="20" Value="65" Maximum="100" HorizontalAlignment="Left" Margin="0,0,0,15"/>
                                <TextBlock Text="Неопределённый (Indeterminate)" Style="{StaticResource BodyTextStyle}"/>
                                <ProgressBar Width="300" Height="20" IsIndeterminate="True" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Всплывающие подсказки" IsExpanded="True" Margin="0,0,0,10">
                            <StackPanel Margin="5">
                                <Button Content="Наведи на меня" ToolTip="Это всплывающая подсказка!"/>
                                <TextBlock Text="Наведи и на этот текст" ToolTip="ToolTip работает и на TextBlock"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Меню и контекстное меню" IsExpanded="True" Margin="0,0,0,10">
                            <StackPanel Margin="5">
                                <Menu Margin="0,0,0,15">
                                    <MenuItem Header="Файл">
                                        <MenuItem Header="Открыть"/>
                                        <MenuItem Header="Сохранить"/>
                                        <MenuItem Header="Выход"/>
                                    </MenuItem>
                                    <MenuItem Header="Правка">
                                        <MenuItem Header="Копировать"/>
                                        <MenuItem Header="Вставить"/>
                                    </MenuItem>
                                </Menu>
                                <Button Content="Нажми ПКМ для контекстного меню">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Контекстное действие 1"/>
                                            <MenuItem Header="Контекстное действие 2"/>
                                            <MenuItem Header="Контекстное действие 3"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ВКЛАДКА 4: Контейнеры компоновки -->
            <TabItem Header="{Tr 'Tab.Containers'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="Grid (Сетка)" Style="{StaticResource Heading3Style}"/>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Height="100" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Rectangle Fill="{StaticResource PrimaryBrush}" Grid.Column="0" Grid.Row="0" Margin="5"/>
                                <Rectangle Fill="{StaticResource SuccessBrush}" Grid.Column="1" Grid.Row="0" Margin="5"/>
                                <Rectangle Fill="{StaticResource ErrorBrush}" Grid.Column="0" Grid.Row="1" Margin="5"/>
                                <Rectangle Fill="{StaticResource InfoBrush}" Grid.Column="1" Grid.Row="1" Margin="5"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="StackPanel (Стек)" Style="{StaticResource Heading3Style}"/>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Height="100" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Fill="Aquamarine" Width="100" Margin="5"/>
                                <Rectangle Fill="#FF5C00" Width="100" Margin="5"/>
                                <Rectangle Fill="#5D2D91" Width="100" Margin="5"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="WrapPanel (Панель с переносом)" Style="{StaticResource Heading3Style}"/>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Height="120" Margin="0,0,0,15">
                            <WrapPanel>
                                <Rectangle Fill="#00B7C3" Width="80" Height="50" Margin="5"/>
                                <Rectangle Fill="#038387" Width="80" Height="50" Margin="5"/>
                                <Rectangle Fill="#00B294" Width="80" Height="50" Margin="5"/>
                                <Rectangle Fill="#013B16" Width="80" Height="50" Margin="5"/>
                                <Rectangle Fill="#5C2D91" Width="80" Height="50" Margin="5"/>
                            </WrapPanel>
                        </Border>

                        <TextBlock Text="DockPanel (Панель закрепления)" Style="{StaticResource Heading3Style}"/>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Height="120" Margin="0,0,0,15">
                            <DockPanel>
                                <Rectangle Fill="{StaticResource PrimaryBrush}" Width="40" DockPanel.Dock="Left" Margin="3"/>
                                <Rectangle Fill="{StaticResource ErrorBrush}" Width="40" DockPanel.Dock="Right" Margin="3"/>
                                <Rectangle Fill="{StaticResource SuccessBrush}" Height="30" DockPanel.Dock="Top" Margin="3"/>
                                <Rectangle Fill="{StaticResource InfoBrush}" Height="30" DockPanel.Dock="Bottom" Margin="3"/>
                                <Rectangle Fill="#5C2D91" Margin="3"/>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="Canvas (Холст)" Style="{StaticResource Heading3Style}"/>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Height="120" Margin="0,0,0,15">
                            <Canvas>
                                <Rectangle Fill="#6db3af" Width="50" Height="50" Canvas.Left="10" Canvas.Top="10"/>
                                <Rectangle Fill="{StaticResource SuccessBrush}" Width="50" Height="50" Canvas.Left="70" Canvas.Top="40"/>
                                <Rectangle Fill="#eb38a0" Width="50" Height="50" Canvas.Left="130" Canvas.Top="15"/>
                            </Canvas>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ВКЛАДКА 5: Работа с данными -->
            <TabItem Header="{Tr 'Tab.Data'}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Исходная таблица" Style="{StaticResource Heading2Style}"/>
                        <ToolBarTray>
                            <ToolBar>
                                <Button Content="{Tr 'Data.Add'}" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                                <Separator/>
                                <Button Content="{Tr 'Data.Delete'}" Command="{Binding DeleteCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                                <Separator/>
                                <Button Content="{Tr 'Data.Copy'}" Command="{Binding CopyCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                            </ToolBar>
                        </ToolBarTray>
                        <DataGrid ItemsSource="{Binding SourceShades}"
                                  SelectedItem="{Binding SelectedSourceShade, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Цвет" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding ColorBrush}" Height="20" Margin="2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="RGB" Binding="{Binding RgbCode}" Width="*"/>
                                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" Margin="20,0"/>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Целевая таблица" Style="{StaticResource Heading2Style}"/>
                        <ToolBarTray>
                            <ToolBar>
                                <Button Content="{Tr 'Data.Paste'}" Command="{Binding PasteCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                                <Separator/>
                                <Button Content="{Tr 'Data.Clear'}" Command="{Binding ClearTargetCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                            </ToolBar>
                        </ToolBarTray>
                        <DataGrid ItemsSource="{Binding TargetShades}"
                                  AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Цвет" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding ColorBrush}" Height="20" Margin="2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="RGB" Binding="{Binding RgbCode}" Width="*"/>
                                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ВКЛАДКА 6: Типы привязок -->
            <TabItem Header="{Tr 'Tab.Bindings'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock Text="Демонстрация режимов привязки" Style="{StaticResource Heading1Style}"/>
                        <TextBlock Text="Измените значение на слайдере вкладки «Основное» и наблюдайте, какие поля обновятся."
                                   Style="{StaticResource CaptionStyle}" Margin="0,0,0,15"/>

                        <GroupBox Header="OneTime (значение фиксируется при загрузке)">
                            <TextBox Text="{Binding FontSize, Mode=OneTime, StringFormat={}{0:F0}}" Margin="10"/>
                        </GroupBox>

                        <GroupBox Header="OneWay (только из ViewModel в UI)">
                            <TextBox Text="{Binding FontSize, Mode=OneWay, StringFormat={}{0:F0}}" Margin="10"/>
                        </GroupBox>

                        <GroupBox Header="TwoWay + PropertyChanged (мгновенное обновление)">
                            <TextBox Text="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F0}}" Margin="10"/>
                        </GroupBox>

                        <GroupBox Header="TwoWay + LostFocus (обновление при потере фокуса)">
                            <TextBox Text="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F0}}" Margin="10"/>
                        </GroupBox>

                        <TextBlock Text="Текущее значение FontSize в ViewModel:" Style="{StaticResource Heading3Style}" Margin="0,20,0,5"/>

                        <TextBlock Text="{Binding FontSize}" FontSize="32" Foreground="{StaticResource PrimaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>