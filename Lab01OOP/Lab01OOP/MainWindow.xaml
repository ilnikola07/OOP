<Window x:Class="Lab01OOP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab01OOP"
        xmlns:vm="clr-namespace:Lab01OOP.ViewModels"
        mc:Ignorable="d"
        Title="Лабораторная работа 2" Height="750" Width="1100">

    <!-- Подключаем ViewModel (ЛР2 п.7) -->
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <TabControl>

            <!-- ============ ВКЛАДКА 1: Основное (ЛР1 п.1.a) ============ -->
            <TabItem Header="Основное">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="Настройки персонализации" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Тема приложения:" Margin="0,0,0,5"/>
                                <ComboBox Width="250" HorizontalAlignment="Left" Margin="0,0,0,10"
                                          ItemsSource="{Binding Themes}"
                                          SelectedItem="{Binding SelectedTheme}"/>

                                <TextBlock Text="Язык приложения:" Margin="0,0,0,5"/>
                                <ComboBox Width="250" HorizontalAlignment="Left"
                                          ItemsSource="{Binding Languages}"
                                          SelectedItem="{Binding SelectedLanguage}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Настройки шрифтов" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Шрифт:" Margin="0,0,0,5"/>
                                <ComboBox Width="250" HorizontalAlignment="Left" Margin="0,0,0,15"
                                          ItemsSource="{Binding Fonts}"
                                          SelectedItem="{Binding SelectedFont}"/>

                                <TextBlock Text="Размер шрифта:" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <Slider Width="250" Minimum="8" Maximum="32"
                                            Value="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            VerticalAlignment="Center" Margin="0,0,15,0"/>
                                    <TextBlock Text="{Binding FontSize, StringFormat={}{0:F0} pt}"
                                               VerticalAlignment="Center" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ ВКЛАДКА 2: Цветовая палитра (ЛР1 п.1.b) ============ -->
            <TabItem Header="Цветовая палитра">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="{Binding SelectedTheme, StringFormat=Текущая тема: {0}}"
                                   FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>

                        <GroupBox Header="Основные и индикаторные цвета" Padding="10">
                            <WrapPanel>
                                <Border Width="120" Height="80" Background="#F3F3F3" Margin="5" BorderBrush="DarkGray" BorderThickness="1">
                                    <TextBlock Text="Основной" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Width="120" Height="80" Background="#0078D7" Margin="5">
                                    <TextBlock Text="Акцентный" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                </Border>
                                <Border Width="120" Height="80" Background="#107C10" Margin="5">
                                    <TextBlock Text="Успех" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                </Border>
                                <Border Width="120" Height="80" Background="#D13438" Margin="5">
                                    <TextBlock Text="Ошибка" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                </Border>
                                <Border Width="120" Height="80" Background="#FF8C00" Margin="5">
                                    <TextBlock Text="Информация" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                </Border>
                            </WrapPanel>
                        </GroupBox>

                        <TextBlock Text="Палитра оттенков (10 оттенков для каждого цвета)" FontWeight="Bold" Margin="0,10,0,10"/>

                        <!-- 5 таблиц с привязками к ViewModel -->
                        <GroupBox Header="Основной (#F3F3F3)" Padding="10">
                            <DataGrid ItemsSource="{Binding ShadesMain}" AutoGenerateColumns="False"
                                      HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True" MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Цвет" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding ColorBrush}" Height="20" Margin="2" BorderBrush="LightGray" BorderThickness="1"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="RGB код" Binding="{Binding RgbCode}" Width="*"/>
                                    <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GroupBox Header="Акцентный (#0078D7)" Padding="10">
                            <DataGrid ItemsSource="{Binding ShadesAccent}" AutoGenerateColumns="False"
                                      HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True" MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Цвет" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding ColorBrush}" Height="20" Margin="2" BorderBrush="LightGray" BorderThickness="1"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="RGB код" Binding="{Binding RgbCode}" Width="*"/>
                                    <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GroupBox Header="Успех (#107C10)" Padding="10">
                            <DataGrid ItemsSource="{Binding ShadesSuccess}" AutoGenerateColumns="False"
                                      HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True" MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Цвет" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding ColorBrush}" Height="20" Margin="2" BorderBrush="LightGray" BorderThickness="1"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="RGB код" Binding="{Binding RgbCode}" Width="*"/>
                                    <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GroupBox Header="Ошибка (#D13438)" Padding="10">
                            <DataGrid ItemsSource="{Binding ShadesError}" AutoGenerateColumns="False"
                                      HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True" MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Цвет" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding ColorBrush}" Height="20" Margin="2" BorderBrush="LightGray" BorderThickness="1"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="RGB код" Binding="{Binding RgbCode}" Width="*"/>
                                    <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GroupBox Header="Информация (#FF8C00)" Padding="10">
                            <DataGrid ItemsSource="{Binding ShadesInfo}" AutoGenerateColumns="False"
                                      HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True" MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Цвет" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding ColorBrush}" Height="20" Margin="2" BorderBrush="LightGray" BorderThickness="1"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="RGB код" Binding="{Binding RgbCode}" Width="*"/>
                                    <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ ВКЛАДКА 3: Элементы управления (ЛР1 п.1.c) ============ -->
            <TabItem Header="Элементы управления">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <Expander Header="Кнопки (Акцент / Критический × состояния)" IsExpanded="True" Margin="0,0,0,10">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Margin="5">
                                    <StackPanel Margin="5">
                                        <TextBlock Text="Акцент" FontWeight="Bold" Background="#0078D7" Foreground="White" Padding="5" HorizontalAlignment="Center"/>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <Button Grid.Row="0" Grid.Column="0" Content="Обычная" Padding="5" Background="#0078D7" Foreground="White"/>
                                            <Button Grid.Row="0" Grid.Column="1" Content="Нажата" Padding="5" Background="#005A9E" Foreground="White"/>
                                            <Button Grid.Row="0" Grid.Column="2" Content="Загрузка" Padding="5" Background="#4FADFF" Foreground="Black"/>
                                            <Button Grid.Row="0" Grid.Column="3" Content="Неактивна" Padding="5" Background="#CCCCCC" Foreground="#666666" IsEnabled="False"/>
                                            <Button Grid.Row="1" Grid.Column="0" Content="Обычная" Padding="5" Background="White" BorderBrush="#0078D7" BorderThickness="1"/>
                                            <Button Grid.Row="1" Grid.Column="1" Content="Нажата" Padding="5" Background="#E6F2FF" BorderBrush="#005A9E" BorderThickness="1"/>
                                            <Button Grid.Row="1" Grid.Column="2" Content="Загрузка" Padding="5" Background="#E6F2FF" BorderBrush="#4FADFF" BorderThickness="1"/>
                                            <Button Grid.Row="1" Grid.Column="3" Content="Неактивна" Padding="5" Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1" IsEnabled="False"/>
                                            <Button Grid.Row="2" Grid.Column="0" Content="Обычная" Padding="5" Background="Transparent" BorderBrush="#0078D7" BorderThickness="1"/>
                                            <Button Grid.Row="2" Grid.Column="1" Content="Нажата" Padding="5" Background="Transparent" BorderBrush="#005A9E" BorderThickness="1"/>
                                            <Button Grid.Row="2" Grid.Column="2" Content="Загрузка" Padding="5" Background="Transparent" BorderBrush="#4FADFF" BorderThickness="1"/>
                                            <Button Grid.Row="2" Grid.Column="3" Content="Неактивна" Padding="5" Background="Transparent" BorderBrush="#CCCCCC" BorderThickness="1" IsEnabled="False"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Margin="5">
                                        <TextBlock Text="Критический" FontWeight="Bold" Background="#D13438" Foreground="White" Padding="5" HorizontalAlignment="Center"/>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <Button Grid.Row="0" Grid.Column="0" Content="Обычная" Padding="5" Background="#D13438" Foreground="White"/>
                                            <Button Grid.Row="0" Grid.Column="1" Content="Нажата" Padding="5" Background="#9A272B" Foreground="White"/>
                                            <Button Grid.Row="0" Grid.Column="2" Content="Загрузка" Padding="5" Background="#FF8A8A" Foreground="Black"/>
                                            <Button Grid.Row="0" Grid.Column="3" Content="Неактивна" Padding="5" Background="#CCCCCC" Foreground="#666666" IsEnabled="False"/>
                                            <Button Grid.Row="1" Grid.Column="0" Content="Обычная" Padding="5" Background="White" BorderBrush="#D13438" BorderThickness="1"/>
                                            <Button Grid.Row="1" Grid.Column="1" Content="Нажата" Padding="5" Background="#FFEBEE" BorderBrush="#9A272B" BorderThickness="1"/>
                                            <Button Grid.Row="1" Grid.Column="2" Content="Загрузка" Padding="5" Background="#FFEBEE" BorderBrush="#FF8A8A" BorderThickness="1"/>
                                            <Button Grid.Row="1" Grid.Column="3" Content="Неактивна" Padding="5" Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1" IsEnabled="False"/>
                                            <Button Grid.Row="2" Grid.Column="0" Content="Обычная" Padding="5" Background="Transparent" BorderBrush="#D13438" BorderThickness="1"/>
                                            <Button Grid.Row="2" Grid.Column="1" Content="Нажата" Padding="5" Background="Transparent" BorderBrush="#9A272B" BorderThickness="1"/>
                                            <Button Grid.Row="2" Grid.Column="2" Content="Загрузка" Padding="5" Background="Transparent" BorderBrush="#FF8A8A" BorderThickness="1"/>
                                            <Button Grid.Row="2" Grid.Column="3" Content="Неактивна" Padding="5" Background="Transparent" BorderBrush="#CCCCCC" BorderThickness="1" IsEnabled="False"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Margin="15,0,0,0">
                                        <TextBlock Text="Переключатели" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <WrapPanel>
                                            <ToggleButton Content="Акцент" Padding="10,5" Margin="5" Background="#0078D7" Foreground="White"/>
                                            <ToggleButton Content="Критический" Padding="10,5" Margin="5" Background="#D13438" Foreground="White"/>
                                            <ToggleButton Content="Неактивен" Padding="10,5" Margin="5" Background="#CCCCCC" Foreground="#666666" IsEnabled="False"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Expander>

                        <Expander Header="Поля ввода и списки" IsExpanded="True" Margin="0,0,0,10">
                            <WrapPanel Margin="5">
                                <StackPanel Margin="5">
                                    <Label Content="TextBox"/>
                                    <TextBox Width="180" Text="Введите текст..."/>
                                </StackPanel>
                                <StackPanel Margin="5">
                                    <Label Content="PasswordBox"/>
                                    <PasswordBox Width="180"/>
                                </StackPanel>
                                <StackPanel Margin="5">
                                    <Label Content="ComboBox"/>
                                    <ComboBox Width="180" SelectedIndex="0">
                                        <ComboBoxItem Content="Элемент 1"/>
                                        <ComboBoxItem Content="Элемент 2"/>
                                        <ComboBoxItem Content="Элемент 3"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="5">
                                    <Label Content="ListBox"/>
                                    <ListBox Width="180" Height="80">
                                        <ListBoxItem Content="Элемент 1"/>
                                        <ListBoxItem Content="Элемент 2"/>
                                        <ListBoxItem Content="Элемент 3"/>
                                    </ListBox>
                                </StackPanel>
                                <StackPanel Margin="5">
                                    <Label Content="RichTextBox"/>
                                    <RichTextBox Width="280" Height="80">
                                        <FlowDocument>
                                            <Paragraph>
                                                Это
                                                <Bold>жирный</Bold> и
                                                <Italic>курсивный</Italic> текст.
                                            </Paragraph>
                                        </FlowDocument>
                                    </RichTextBox>
                                </StackPanel>
                            </WrapPanel>
                        </Expander>

                        <Expander Header="Текст и метки" IsExpanded="True" Margin="0,0,0,10">
                            <StackPanel Margin="5">
                                <Label Content="Заголовок 1 (H1)" FontSize="24" FontWeight="Bold"/>
                                <Label Content="Заголовок 2 (H2)" FontSize="18" FontWeight="SemiBold"/>
                                <Label Content="Заголовок 3 (H3)" FontSize="14" FontWeight="Medium"/>
                                <TextBlock Text="Обычный текст (Body)" FontSize="14"/>
                                <TextBlock Text="Подпись (Caption)" FontSize="10" Foreground="Gray"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="TreeView" IsExpanded="True" Margin="0,0,0,10">
                            <TreeView Width="250" Height="150" HorizontalAlignment="Left">
                                <TreeViewItem Header="Корневой узел 1">
                                    <TreeViewItem Header="Подузел 1.1"/>
                                    <TreeViewItem Header="Подузел 1.2">
                                        <TreeViewItem Header="Вложенный 1.2.1"/>
                                    </TreeViewItem>
                                </TreeViewItem>
                                <TreeViewItem Header="Корневой узел 2">
                                    <TreeViewItem Header="Подузел 2.1"/>
                                </TreeViewItem>
                            </TreeView>
                        </Expander>

                        <Expander Header="DataGrid (привязан к ViewModel)" IsExpanded="True" Margin="0,0,0,10">
                            <DataGrid ItemsSource="{Binding SampleItems}" AutoGenerateColumns="False"
                                      CanUserAddRows="False" IsReadOnly="True" Height="180" Margin="5">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                    <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                                    <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>

                        <Expander Header="ProgressBar" IsExpanded="True" Margin="0,0,0,10">
                            <StackPanel Margin="5">
                                <TextBlock Text="Определённый (65%)" Margin="0,0,0,5"/>
                                <ProgressBar Width="300" Height="20" Value="65" Maximum="100" HorizontalAlignment="Left" Margin="0,0,0,15"/>
                                <TextBlock Text="Неопределённый (Indeterminate)" Margin="0,0,0,5"/>
                                <ProgressBar Width="300" Height="20" IsIndeterminate="True" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Всплывающие подсказки" IsExpanded="True" Margin="0,0,0,10">
                            <StackPanel Margin="5">
                                <Button Content="Наведи на меня" Padding="10,5" HorizontalAlignment="Left"
                                        ToolTip="Это всплывающая подсказка!"/>
                                <TextBlock Text="Наведи и на этот текст" ToolTip="ToolTip работает и на TextBlock"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Меню и контекстное меню" IsExpanded="True" Margin="0,0,0,10">
                            <StackPanel Margin="5">
                                <Menu Margin="0,0,0,15">
                                    <MenuItem Header="Файл">
                                        <MenuItem Header="Открыть"/>
                                        <MenuItem Header="Сохранить"/>
                                        <MenuItem Header="Выход"/>
                                    </MenuItem>
                                    <MenuItem Header="Правка">
                                        <MenuItem Header="Копировать"/>
                                        <MenuItem Header="Вставить"/>
                                    </MenuItem>
                                </Menu>
                                <Button Content="Нажми ПКМ для контекстного меню" HorizontalAlignment="Left" Padding="10,5">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Контекстное действие 1"/>
                                            <MenuItem Header="Контекстное действие 2"/>
                                            <MenuItem Header="Контекстное действие 3"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ ВКЛАДКА 4: Контейнеры компоновки (ЛР1 п.1.d) ============ -->
            <TabItem Header="Контейнеры компоновки">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="Grid (Сетка)" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Border BorderBrush="Gray" BorderThickness="1" Height="100" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Rectangle Fill="#0078D7" Grid.Column="0" Grid.Row="0" Margin="5"/>
                                <Rectangle Fill="#107C10" Grid.Column="1" Grid.Row="0" Margin="5"/>
                                <Rectangle Fill="#D13438" Grid.Column="0" Grid.Row="1" Margin="5"/>
                                <Rectangle Fill="#FF8C00" Grid.Column="1" Grid.Row="1" Margin="5"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="StackPanel (Стек)" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Border BorderBrush="Gray" BorderThickness="1" Height="100" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Fill="Aquamarine" Width="100" Margin="5"/>
                                <Rectangle Fill="#FF5C00" Width="100" Margin="5"/>
                                <Rectangle Fill="#5D2D91" Width="100" Margin="5"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="WrapPanel (Панель с переносом)" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Border BorderBrush="Gray" BorderThickness="1" Height="120" Margin="0,0,0,15">
                            <WrapPanel>
                                <Rectangle Fill="#00B7C3" Width="80" Height="50" Margin="5"/>
                                <Rectangle Fill="#038387" Width="80" Height="50" Margin="5"/>
                                <Rectangle Fill="#00B294" Width="80" Height="50" Margin="5"/>
                                <Rectangle Fill="#013B16" Width="80" Height="50" Margin="5"/>
                                <Rectangle Fill="#5C2D91" Width="80" Height="50" Margin="5"/>
                            </WrapPanel>
                        </Border>

                        <TextBlock Text="DockPanel (Панель закрепления)" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Border BorderBrush="Gray" BorderThickness="1" Height="120" Margin="0,0,0,15">
                            <DockPanel>
                                <Rectangle Fill="#0078D7" Width="40" DockPanel.Dock="Left" Margin="3"/>
                                <Rectangle Fill="#D13438" Width="40" DockPanel.Dock="Right" Margin="3"/>
                                <Rectangle Fill="#107C10" Height="30" DockPanel.Dock="Top" Margin="3"/>
                                <Rectangle Fill="#FF8C00" Height="30" DockPanel.Dock="Bottom" Margin="3"/>
                                <Rectangle Fill="#5C2D91" Margin="3"/>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="Canvas (Холст)" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Border BorderBrush="Gray" BorderThickness="1" Height="120" Margin="0,0,0,15">
                            <Canvas>
                                <Rectangle Fill="#6db3af" Width="50" Height="50" Canvas.Left="10" Canvas.Top="10"/>
                                <Rectangle Fill="#107C10" Width="50" Height="50" Canvas.Left="70" Canvas.Top="40"/>
                                <Rectangle Fill="#eb38a0" Width="50" Height="50" Canvas.Left="130" Canvas.Top="15"/>
                            </Canvas>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ ВКЛАДКА 5: Работа с данными (ЛР2 п.5, п.6) ============ -->
            <TabItem Header="Работа с данными">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Исходная таблица -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Исходная таблица" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ToolBarTray>
                            <ToolBar>
                                <Button Content="Добавить" Command="{Binding AddCommand}" Padding="8,4" Margin="2"/>
                                <Separator/>
                                <Button Content="Удалить" Command="{Binding DeleteCommand}" Padding="8,4" Margin="2"/>
                                <Separator/>
                                <Button Content="Копировать" Command="{Binding CopyCommand}" Padding="8,4" Margin="2"/>
                            </ToolBar>
                        </ToolBarTray>
                        <DataGrid ItemsSource="{Binding SourceShades}"
                      SelectedItem="{Binding SelectedSourceShade, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Цвет" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding ColorBrush}" Height="20" Margin="2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="RGB" Binding="{Binding RgbCode}" Width="*"/>
                                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <!-- Вертикальный разделитель вместо стрелки -->
                    <Border Grid.Column="1" Width="1" Background="#D0D0D0" Margin="20,0"/>

                    <!-- Целевая таблица -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Целевая таблица" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ToolBarTray>
                            <ToolBar>
                                <Button Content="Вставить" Command="{Binding PasteCommand}" Padding="8,4" Margin="2"/>
                                <Separator/>
                                <Button Content="Очистить" Command="{Binding ClearTargetCommand}" Padding="8,4" Margin="2"/>
                            </ToolBar>
                        </ToolBarTray>
                        <DataGrid ItemsSource="{Binding TargetShades}"
                      AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Цвет" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding ColorBrush}" Height="20" Margin="2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="RGB" Binding="{Binding RgbCode}" Width="*"/>
                                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============ ВКЛАДКА 6: Типы привязок (ЛР2 п.8) ============ -->
            <TabItem Header="Типы привязок">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock Text="Демонстрация режимов привязки" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                        <TextBlock Text="Измените значение на слайдере вкладки «Основное» и наблюдайте, какие поля обновятся."
                                   Foreground="Gray" Margin="0,0,0,15"/>

                        <GroupBox Header="OneTime (значение фиксируется при загрузке)">
                            <TextBox Text="{Binding FontSize, Mode=OneTime, StringFormat={}{0:F0}}" Margin="10"/>
                        </GroupBox>

                        <GroupBox Header="OneWay (только из ViewModel в UI)">
                            <TextBox Text="{Binding FontSize, Mode=OneWay, StringFormat={}{0:F0}}" Margin="10"/>
                        </GroupBox>

                        <GroupBox Header="TwoWay + PropertyChanged (мгновенное обновление)">
                            <TextBox Text="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F0}}" Margin="10"/>
                        </GroupBox>

                        <GroupBox Header="TwoWay + LostFocus (обновление при потере фокуса)">
                            <TextBox Text="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F0}}" Margin="10"/>
                        </GroupBox>

                        <TextBlock Text="Текущее значение FontSize в ViewModel:" FontWeight="Bold" Margin="0,20,0,5"/>
                        <TextBlock Text="{Binding FontSize}" FontSize="32" Foreground="#0078D7"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>